{
  "name": "deskpet",
  "productName": "DeskPet",
  "version": "1.1.2",
  "private": true,
  "description": "Windows desktop pet application",
  "author": "DeskPet contributors",
  "main": ".vite/build/main.cjs",
  "scripts": {
    "generate:assets": "node scripts/generate-app-icon.mjs",
    "validate:assets": "node scripts/validate-assets.mjs",
    "check:package": "node scripts/check-package.mjs",
    "prestart": "npm run generate:assets",
    "start": "electron-forge start",
    "prepackage": "npm run generate:assets",
    "package": "electron-forge package",
    "premake": "npm run generate:assets",
    "make": "electron-forge make",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron-forge/plugin-vite": "^8.0.1",
    "@electron/fuses": "^2.1.3",
    "@eslint/js": "^10.0.1",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "45.1.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "uiohook-napi": "^1.5.5"
  }
}
